#!/usr/bin/env bash
# FINN 0.10 environment -- COPY to finn.env.sh and edit. NOTHING IS INSTALLED YET.
#
# PAPER FACT: FINN version 0.10 (paper section 3).
# REPOSITORY FACT: the reference bitstream was built with Vivado 2022.1
#   (visdrone.hwh header), which the paper never states.
# DECISION D10 (2026-10-20): FINN 0.10's docs and run-docker.sh require
#   Vitis/Vivado 2022.2 (2022.1 is FINN 0.9's pairing). Resolved: FINN 0.10 +
#   2022.2, keeping the paper's FINN version. See DECISIONS.md.

# --- toolchain location -----------------------------------------------------
# MUST live on /mnt/data10tb: / has only ~74 GB free (84% used).
export FINN_XILINX_PATH=/mnt/data10tb/Xilinx
export FINN_XILINX_VERSION=2022.2

# --- build area -------------------------------------------------------------
export FINN_HOST_BUILD_DIR=/mnt/data10tb/finn_build
export FINN_DOCKER_EXTRA="-v /mnt/data10tb:/mnt/data10tb"

# --- HOST CONSTRAINT: this machine has 15 GB RAM total ----------------------
# Parallel Vitis HLS jobs will OOM. Keep this at 1.
export NUM_DEFAULT_WORKERS=1

# Verilator traces over millions of cycles are infeasible here (A27).
export RTLSIM_TRACE=0

# --- board definition -------------------------------------------------------
# REPOSITORY FACT board: myir.com:mys-7z020:part0:2.1
# The files are ABSENT; see finn_build/platform/mys-7z020/README.md
export FINN_BOARD_FILES=/mnt/data10tb/board_files

# --- sanity ----------------------------------------------------------------
# python3 finn_build/step_04_synth.py --preflight
